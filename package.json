{
  "name": "yume-dsl-shiki-highlight",
  "version": "2.1.0",
  "description": "Minimal Shiki syntax-highlighting support for yume-dsl-rich-text",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsup --target esnext",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node tests/run-tests.mjs"
  },
  "keywords": [
    "yume-dsl",
    "yume-dsl-rich-text",
    "dsl",
    "rich-text",
    "shiki",
    "syntax-highlighting",
    "syntax-highlight",
    "highlight",
    "textmate",
    "textmate-grammar",
    "grammar",
    "tokenizer",
    "markup",
    "custom-markup"
  ],
  "author": "Hoshino Yumeka",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiba233/yume-dsl-shiki-highlight.git"
  },
  "homepage": "https://github.com/chiba233/yume-dsl-shiki-highlight#readme",
  "bugs": {
    "url": "https://github.com/chiba233/yume-dsl-shiki-highlight/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "yume-dsl-rich-text": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  }
}
